    .mega-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 980px;
        background: #fff;
        z-index: 2000;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        padding: 20px;
    }

    .list-group {
        max-height: 500px;
        overflow-y: auto;
        background: #fff;
        border-radius: 5px;
    }

    .category-item {
        padding: 10px 15px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .category-item:hover {
        background-color: #f8f9fa;
    }

    .mega-menu-content {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 15px;
    }

    .menu-column {
        flex: 1;
        min-width: 0;
    }

    .menu-column h6 {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 10px;
        color: #000;
    }

    .menu-column ul {
        list-style: none;
        padding: 0;
    }

    .menu-column ul li a {
        display: block;
        padding: 5px 0;
        color: #000;
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        font-size: 14px;
    }

    .menu-column ul li a:hover {
        color: #007bff;
    }

    @media (max-width: 768px) {
        .mega-menu {
            width: 100%;
            left: 0;
        }

        .list-group {
            max-height: 300px;
        }

        .mega-menu-content {
            flex-direction: column;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const megaMenu = document.querySelector('#mega-menu');
        const categoryItems = document.querySelectorAll('.category-item');
        let isMouseOver = false;

        categoryItems.forEach(item => {
            item.addEventListener('mouseenter', function () {
                const megaMenuContent = this.getAttribute('data-mega-menu');
                if (megaMenuContent) {
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = megaMenuContent;
                    const content = tempDiv.querySelector('.mega-menu-content');
                    if (content) {
                        megaMenu.innerHTML = '';
                        megaMenu.appendChild(content);
                        megaMenu.style.display = 'block';
                    }
                }
                isMouseOver = true;
            });

            item.addEventListener('mouseleave', function () {
                isMouseOver = false;
                setTimeout(() => {
                    if (!isMouseOver) {
                        megaMenu.style.display = 'none';
                        megaMenu.innerHTML = '';
                    }
                }, 200);
            });
        });

        megaMenu.addEventListener('mouseenter', () => {
            isMouseOver = true;
        });

        megaMenu.addEventListener('mouseleave', () => {
            isMouseOver = false;
            setTimeout(() => {
                if (!isMouseOver) {
                    megaMenu.style.display = 'none';
                    megaMenu.innerHTML = '';
                }
            }, 200);
        });
    });
</script>